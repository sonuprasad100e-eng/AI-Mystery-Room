PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/ai-mystery-room
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
VITE_API_BASE_URL=http://localhost:5000/api

# AI Image Generation Configuration
# Set to 'true' to attempt automated crime-scene photograph generation using the free AI provider.
# When 'false', cases instantly generate and display procedural vector SVG evidence schematics.
ENABLE_AI_IMAGE_GEN=false

# Image provider: 'cloudflare' (FLUX.1 Schnell), 'pollinations' (free without authentication), or 'huggingface'
IMAGE_PROVIDER=pollinations

# Optional credentials (loaded exclusively on backend, never exposed to client):
# Cloudflare Workers AI credentials (for 'cloudflare' provider with @cf/black-forest-labs/flux-1-schnell):
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Pollinations API key (optional: removes free-tier rate limit):
POLLINATIONS_API_KEY=
# Hugging Face User Access Token (optional: for 'huggingface' provider):
HF_API_TOKEN=


