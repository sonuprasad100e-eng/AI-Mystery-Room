# AI Mystery Room - Frontend Environment Variables

# Base URL for the backend API.
# In local development: leave empty to use Vite's local dev-server proxy, or set to:
# VITE_API_BASE_URL=http://localhost:5000/api
#
# In production on Vercel: set to your deployed Render backend API URL:
# VITE_API_BASE_URL=https://ai-mystery-room-msfn.onrender.com/api
VITE_API_BASE_URL=http://localhost:5000/api
